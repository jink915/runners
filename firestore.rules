rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 최고 관리자 이메일 (앱의 멤버 관리에서 권한을 뺄 수 없음)
    function adminEmails() {
      return ['jink021124@gmail.com'];
    }
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in adminEmails();
    }
    // 앱에서 가입 신청 → 관리자 승인으로 관리하는 멤버 정보
    function myPath() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function hasMe() { return signedIn() && exists(myPath()); }
    function me() { return get(myPath()).data; }
    function isMember() { return isOwner() || (hasMe() && me().status == 'approved'); }
    function isAdmin() { return isOwner() || (hasMe() && me().status == 'approved' && me().role == 'admin'); }
    function okName(n) { return n is string && n.size() > 0 && n.size() <= 20; }
    // 부서 권한: 관리자 = 모든 부서·모든 권한 / 운영자 = 맡은 부서에서 관리자와 같은 권한 / 멤버 = 맡은 부서 보기만
    // (depts가 없는 예전 멤버는 모든 부서)
    function myDepts() { return me().get('depts', ['social', 'care']); }
    function sees(d) { return isAdmin() || (isMember() && hasMe() && d in myDepts()); }
    function canEdit(d) { return isAdmin() || (isMember() && hasMe() && me().role == 'operator' && d in myDepts()); }

    // 앱이 "내가 최고 관리자인가"를 확인하는 용도
    match /admins/{email} {
      allow read: if isOwner() && request.auth.token.email == email;
      allow write: if false;
    }
    // 멤버: 본인은 가입 신청(대기 상태로만)과 대기 중 이름 수정, 관리자는 승인·거절·권한·이름 관리
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && okName(request.resource.data.name)
        && (isOwner()
            || (request.resource.data.status == 'pending'
                && request.resource.data.role == 'member'
                && request.resource.data.get('depts', []).size() == 0
                && request.resource.data.owner == false));
      allow update: if (isAdmin()
            && request.resource.data.owner == resource.data.owner
            && okName(request.resource.data.name)
            && request.resource.data.status in ['pending', 'approved', 'rejected']
            && request.resource.data.role in ['member', 'operator', 'admin']
            && request.resource.data.get('depts', []) is list
            && request.resource.data.get('depts', []).hasOnly(['social', 'care']))
        || (signedIn() && request.auth.uid == uid
            && resource.data.status == 'pending'
            && okName(request.resource.data.name)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if (isAdmin() && resource.data.owner != true) || (signedIn() && request.auth.uid == uid);
    }
    // 사회부: 주일 배정(사회·대표기도·찬송)
    match /weeks/{date} {
      allow read: if sees('social');
      allow write: if canEdit('social');
    }
    // 챙김부: 러너스 생일
    match /birthdays/{id} {
      allow read: if sees('care');
      allow write: if canEdit('care')
        && (request.resource == null
            || (okName(request.resource.data.name)
                && request.resource.data.month is int && request.resource.data.month >= 1 && request.resource.data.month <= 12
                && request.resource.data.day is int && request.resource.data.day >= 1 && request.resource.data.day <= 31));
    }
    // 사회부: 대표기도 명단(메모·사유 포함)과 기도제목 — 사회부 관리자·운영자만
    match /people/{id} {
      allow read, write: if canEdit('social');
    }
    match /config/{id} {
      allow read: if sees('social');
      allow write: if canEdit('social');
    }
    // 알림 받을 기기: 승인된 멤버가 자기 기기만, 자기 멤버 이름으로만 등록. 목록은 관리자만
    match /pushTokens/{token} {
      allow create, update: if isMember() && hasMe()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token == token
        && request.resource.data.name == me().name
        && request.resource.data.admin == (me().role == 'admin' || isOwner())
        && request.resource.data.prefs is map;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow read: if isAdmin();
    }
  }
}
