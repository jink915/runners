rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 운영자(편집 가능) 이메일 — 여기에 추가·삭제
    function adminEmails() {
      return ['jink021124@gmail.com'];
    }
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in adminEmails();
    }

    // 앱이 "내가 운영자인가"를 확인하는 용도
    match /admins/{email} {
      allow read: if isAdmin() && request.auth.token.email == email;
      allow write: if false;
    }
    // 주일 배정(사회·대표기도·찬송): 누구나 보기, 운영자만 수정
    match /weeks/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // 대표기도 명단(메모·사유 포함)과 기도제목: 운영자만
    match /people/{id} {
      allow read, write: if isAdmin();
    }
    match /config/{id} {
      allow read, write: if isAdmin();
    }
    // 사회자 알림을 받을 기기 등록: 로그인한 사람이 자기 기기만 등록·해제, 목록은 운영자만
    match /pushTokens/{token} {
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token == token
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }
  }
}
