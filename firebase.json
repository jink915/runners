{
  "functions": [{ "source": "functions", "codebase": "default", "runtime": "nodejs22", "ignore": ["node_modules", "region.mjs", "gh-remind.mjs", ".git"] }],
  "hosting": {
    "site": "anam1-runners",
    "public": "_site",
    "headers": [
      { "source": "**/*.@(html|js|css|json|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(png|webp|svg|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  }
}
